# LLM API key (required — pick one)
# GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override default model
# For Groq, e.g.: LLM_MODEL=openai/gpt-oss-20b
# LLM_MODEL=gemini-2.5-flash
# For OpenRouter, e.g.: LLM_MODEL=google/gemini-2.0-flash-exp:free

# Optional: real HITL interrupts (default: mock approval)
# LANGGRAPH_INTERRUPT=true

# Optional: persistence backend
CHECKPOINTER=memory
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langgraph_lab

LOG_LEVEL=INFO
